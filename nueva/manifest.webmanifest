{"name":"Pokémon Libre · tu colección de cartas","short_name":"Pokémon Libre","description":"Todas las cartas de tus Pokémon, en inglés y en japonés. Marca las que tienes y descubre las que te faltan. Sin cuenta y sin anuncios.","start_url":"/pokemon-libre/nueva/","display":"standalone","background_color":"#5aaee0","theme_color":"#5aaee0","lang":"es","scope":"/pokemon-libre/nueva/","orientation":"portrait","categories":["utilities","lifestyle"],"icons":[{"src":"iconos/icono-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"iconos/icono-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"iconos/icono-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}
